        {
          "name": "/user/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. 断言状态码是200\r\npm.test(\"登录成功，状态码200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. 断言响应里有access_token字段\r\npm.test(\"响应包含access_token\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"access_token\");\r\n});\r\n\r\n// 3. 自动提取token并保存到环境变量\r\nvar jsonData = pm.response.json();\r\npm.environment.set(\"token\", jsonData.access_token);\r\n\r\n// 4. 在控制台打印一下，方便确认\r\nconsole.log(\"Token已自动保存:\", jsonData.access_token);\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"customer@practicesoftwaretesting.com\",\r\n  \"password\": \"welcome01\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://api.practicesoftwaretesting.com/users/login",
              "protocol": "https",
