      "name": "New Folder",
      "item": [
        {
          "name": "/products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ===== 断言部分 =====\r\n// 1. 状态码是200\r\npm.test(\"商品列表返回200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. 响应里有data字段，且是数组\r\npm.test(\"响应包含data数组\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"data\");\r\n    pm.expect(jsonData.data).to.be.an(\"array\");\r\n});\r\n\r\n// 3. data数组不为空\r\npm.test(\"商品列表不为空\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.data.length).to.be.above(0);\r\n});\r\n\r\n// ===== 变量提取部分 =====\r\n// 自动提取第一个商品的ID，保存到环境变量\r\nvar jsonData = pm.response.json();\r\nif (jsonData.data.length > 0) {\r\n    pm.environment.set(\"product_id\", jsonData.data[0].id);\r\n    console.log(\"商品ID已自动保存:\", jsonData.data[0].id);\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.practicesoftwaretesting.com/products",
              "protocol": "https",
              "host": [
                "api",
                "practicesoftwaretesting",
                "com"
              ],
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
